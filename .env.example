# Copy this file to .env and fill in real values. .env is gitignored.
# These variables are read by docker-compose.dev.yml; for local IntelliJ runs
# put them into Run Configuration → Environment variables.

# --- AI assistant (Жанибек) ---
# Provider: groq | gemini
AI_PROVIDER=groq
# Free Groq key from https://console.groq.com  (looks like gsk_...)
GROQ_API_KEY=
# Optional fallback provider (https://aistudio.google.com)
GEMINI_API_KEY=

# --- Database (local dev) ---
SPRING_DATASOURCE_PASSWORD=sara1234

# --- JWT (use a long random string, >= 32 chars) ---
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
